# fluxiaRSS 运行配置（复制为 .env 使用，密钥不入库）
# 采集
PER_FEED_CAP=20
DIGEST_SIZE=8
EXPLORATION_BUDGET=0.15

# ---- DeepSeek（概述 LLM，OpenAI 兼容）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=40

# ---- Honcho（自托管记忆层，可选；配置说明见 DEPLOY-HONCHO.md）----
# 以下为示例，勿提交真实 key
# LLM_OPENAI_API_KEY=
# DERIVER_MODEL_CONFIG__MODEL=deepseek-chat
# DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1
# EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
# EMBEDDING_MODEL_CONFIG__MODEL=ep-<你的接入点ID>
# EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=
