# fluxiaRSS 运行配置（复制为 .env 使用，密钥不入库）
# 采集
PER_FEED_CAP=20
MAX_AGE_DAYS=2
# 按源放宽年龄窗口（慢更新源，天）；其余源回退 MAX_AGE_DAYS。JSON 整体覆盖默认字典
SOURCE_MAX_AGE_DAYS={"Cloudflare AI": 30, "Vercel Blog": 30}
# digest 候选池只取最近 N 小时内采集到的文章（今日新鲜池），空池回退全池
FRESH_WINDOW_HOURS=24
# digest 每源配额：每源最多保留前 N 篇，防单源霸屏；0=不限制
DIGEST_MAX_PER_SOURCE=3
# digest 中「研究前沿」类文章硬上限（research 类最多 N 篇，其余为实践/概念）
RESEARCH_MAX_IN_DIGEST=2
DIGEST_SIZE=8
EXPLORATION_BUDGET=0.15
# 排序时关键词命中的加成（软信号，低于 Honcho 画像加成的 0.5）
KEYWORD_HIT_BONUS=0.3
# 概述时注入的用户主题定位（软约束，引导 LLM 概述贴合主题，不硬过滤）
SUMMARIZE_TOPIC=AI 智能体应用与前沿 agent 开发实践，关注 Agent 框架、MCP 生态、AI 应用落地；对模型底层 RL/调参不感兴趣。
# 采集请求的 User-Agent（部分源拦截默认 UA，如 qbitai）
FEED_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
SUMMARY_WORKERS=8


# Zone 分区种子配置（可选，JSON 格式，init_db 时播种预置区）
# 以下示例创建了两个区：creator（创作灵感·海外见闻）和 agent（AI Agent 前沿）
# 部署时按需修改 feeds/keywords/config。设为空字串或删除此行则不播种。
FLUXIARSS_ZONES={"creator":{"display":"创作灵感·海外见闻","feeds":[{"name":"Waxy.org Links","url":"https://waxy.org/category/links/feed/","topic":"creator"},{"name":"Kottke.org","url":"https://feeds.kottke.org/main","topic":"creator"},{"name":"Marginal Revolution","url":"https://marginalrevolution.com/feed","topic":"creator"}],"keywords":[],"config":{"digest_size":5,"fresh_window_hours":48,"honcho_workspace":"fluxiars_creator","honcho_session":"reading","collect_hour":3,"collect_minute":17}}}

# ---- DeepSeek（概述 LLM，OpenAI 兼容）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=40

# ---- Honcho（自托管记忆层，可选；配置说明见 DEPLOY-HONCHO.md）----
# 开启 =1；接入点 key 见 DEPLOY-HONCHO.md
HONCHO_ENABLED=1
HONCHO_BASE_URL=http://localhost:8001
HONCHO_WORKSPACE_ID=fluxiars
HONCHO_PEER_ID=user
HONCHO_SESSION_ID=reading
# 以下为示例，勿提交真实 key
# LLM_OPENAI_API_KEY=
# DERIVER_MODEL_CONFIG__MODEL=deepseek-chat
# DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.deepseek.com/v1
# EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
# EMBEDDING_MODEL_CONFIG__MODEL=ep-<你的接入点ID>
# EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=


